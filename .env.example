# ==============================================================================
# DeployGuard - Enterprise Environment Variables Configuration
# Copy this file to .env and configure secrets prior to deployment
# ==============================================================================

# Database Configuration
POSTGRES_DB=deployguard
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/deployguard
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_secure_database_password

# JWT Security Configuration (Requires a secure, random string of minimum 256 bits / 32 bytes)
JWT_SECRET=your_secure_random_base64_or_hex_encoded_key_min_256_bits
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Server Port
PORT=8080
