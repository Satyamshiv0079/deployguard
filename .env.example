# ==============================================================================
# DeployGuard - Enterprise Environment Variables Configuration
# Copy this file to .env and configure secrets prior to deployment
# ==============================================================================

# Database Configuration
POSTGRES_DB=deployguard
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/deployguard
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT Security Configuration (Generate minimum 256-bit secure key for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Server Port
PORT=8080
